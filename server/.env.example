# Yeeps 2.32.0-buddy self-host server settings.
# start.bat / start.sh copy this to .env on first run (with a random
# DEVICE_KEY_PEPPER). Edit .env, not this file. Never share .env.

# ── Database ────────────────────────────────────────────────────────────────
# Local MongoDB (install MongoDB Community Server) ...
MONGO_URI=mongodb+srv://sapphireunnecessary_db_user:xmcijefSg2kRp1hd@ogyeeps.ftiowhe.mongodb.net
# ... or a free MongoDB Atlas cluster: paste its connection string instead, e.g.
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DB_NAME=OGYeeps
CLIENT_PROFILE=peoplethatarenotgayy
REQUIRED_CLIENT_VERSION=2.32.0-yeeper

# ── Network ─────────────────────────────────────────────────────────────────
PORT=8000

# ── Headset keys ────────────────────────────────────────────────────────────
# Secret mixed into stored headset keys. Set once; changing it later makes every
# player look like they're on a new headset.
DEVICE_KEY_PEPPER=

# ── World ───────────────────────────────────────────────────────────────────
# Load the base room layout and Buddy catalog into an empty database at startup.
SEED_WORLD=1

# ── Optional ────────────────────────────────────────────────────────────────
# Link in "update your APK" / closed messages.
DISCORD_INVITE_URL=https://discord.gg/UzcRATz5kQ
# Account IDs (comma-separated) allowed to ban/warn from inside the game.
MOD_STAFF=o_25596005490046939
# Account IDs allowed to hold the "blaze" role (BLAZE blocks, saving shared maps in game).
BLAZE_HOLDERS=o_25596005490046939
# Only allow listed APK builds (off by default; a rebuilt APK changes its hashes).
ENFORCE_CLIENT_BUILD=0
ALLOWED_CLIENT_BUILDS=buddy1
# Building: every room can switch play/creative and anyone can edit official maps in game.
UNLOCK_ALL_MODES=1
# Optional comma-separated accounts allowed to save every hair color.
UNRESTRICTED_COSMETIC_ACCOUNTS=o_25596005490046939
# Optional Buddy staff accounts explicitly approved to use live79's untagged APK.
# Still requires MOD_STAFF membership and the account's bound headset key.
MOD_UNTAGGED_STAFF=o_25596005490046939
